#!/usr/bin/env bash
# fleet-build-lock — serialize heavy builds fleet-wide (Drew's build
# policy, 2026-11-02; replaces the abolished laptop load gate).
#
# At most FLEET_BUILD_SLOTS (default 2) heavy builds (cargo, nix) run
# at once on this host. A build waits for a free slot; load alone
# never parks work. Cargo builds get CARGO_BUILD_JOBS=<half the
# cores> unless the caller already set it.
#
# Usage: fleet-build-lock [--] command [args...]
# Run it ON the host doing the building (the laptop), e.g. from the
# sandbox via the laptop agent:
#   python3 ~/tools/laptop-agent.py exec --shell -- '~/tools/fleet-build-lock cargo test ...'
# Env: FLEET_BUILD_SLOTS (default 2)
#      FLEET_BUILD_LOCKDIR (default ~/.fleet-build-locks)
set -u

slots=${FLEET_BUILD_SLOTS:-2}
lockdir=${FLEET_BUILD_LOCKDIR:-"$HOME/.fleet-build-locks"}
mkdir -p "$lockdir"

if [ "${1:-}" = "--" ]; then shift; fi
if [ "$#" -eq 0 ]; then
  echo "usage: fleet-build-lock [--] command [args...]" >&2
  exit 2
fi

# Default cargo parallelism to half the cores (min 1) unless preset.
if [ -z "${CARGO_BUILD_JOBS:-}" ]; then
  cores=$(nproc 2>/dev/null || echo 2)
  jobs=$(( cores / 2 ))
  [ "$jobs" -lt 1 ] && jobs=1
  export CARGO_BUILD_JOBS="$jobs"
fi

# Acquire one of $slots flock slots, blocking until one frees.
acquired=""
while [ -z "$acquired" ]; do
  i=1
  while [ "$i" -le "$slots" ]; do
    fd=$(( 200 + i ))
    eval "exec $fd>\"$lockdir/slot-$i.lock\""
    if flock -n "$fd"; then
      acquired=$i
      break
    fi
    eval "exec $fd>&-"
    i=$(( i + 1 ))
  done
  [ -z "$acquired" ] && sleep 5
done

echo "fleet-build-lock: slot $acquired/$slots, CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-unset}: $*" >&2
# exec keeps the slot fd open in the build process; the lock releases
# when the build exits.
exec "$@"
