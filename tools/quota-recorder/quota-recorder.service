# Canonical: developing-today/code pkgs/deploy/ — the deploy registry (services.nix quota-recorder target, with its timer field) renders the live units; this hatch unit is the superseded hand-copied source.
[Unit]
Description=Quota recorder — 1-minute Muse subscription quota snapshots, file-first with Supabase landing
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/home/hatch
ExecStart=/usr/bin/python3 /home/hatch/tools/quota-recorder.py
