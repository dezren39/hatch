{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/codedb-block-legacy.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/codedb-warmup.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__codedb__*"
    ]
  }
}
