# === Nix store (binaries, large) ===
nix-persist/

# === User private files ===
user/

# === Logs and telemetry ===
logs/

# === System dot dirs (caches, configs, keys) ===
.bun/
.cache/
.config/
.local/
.npm/
.pki/
.ssh/
.rustup/
.nix-defexpr/
.nix-portable/
.nix-profile
.postgres-ready
.hatch-db-change-signals
.vnc/
.Xauthority
runtime.lock

# === Toolchain binaries (reinstalled via scripts) ===
tools/go/
tools/cargo/
tools/rustup/
tools/nix-portable

# === Large archives ===
tools/*.tar.gz
tools/*.tar.zst
tools/*.prev
*.tar.zst

# === Compiled artifacts (source is tracked) ===
tools/taint-shim/*.so
tools/taint-shim/*.o

# === Test directories ===
captest/
taint-test/
tools/chowntest

# === Personal / sensitive (never track) ===
MEMORY.md
USER.md
PROACTIVE_PREFERENCES.md
SOUL.md
IDENTITY.md
HEARTBEAT.md
AGENTS.md

# === Private repo (~/hatch-personal, symlinked back into this tree) ===
# The symlinks above/below resolve into hatch-personal; never track either.
/hatch-personal/
# (slash-less: also matches the symlinks, which trailing-slash patterns miss)
/memory
/dreams
/logs
/user

# === Platform runtime state ===
# agents/ contains subagent execution records (sessions.json metadata +
# .jsonl transcripts). Too sensitive for git — never track.
agents/
assets/
config/
data/
dreams/
hooks/
memory/
subscriptions/
workspace/*
!workspace/avatars/
!workspace/avatars/*
# Supabase muse-dev tree (migrations, functions, backup tooling) IS versioned
# per Drew 2026-10-25: everything not huge belongs in git.
!workspace/supabase/
!workspace/supabase/**
workspace/supabase/**/__pycache__/
# Private-only per workspace policy 2026-10-21 (infrastructure identifiers /
# personal research corpus) — canonical copies in hatch-personal
# workspace/imported/2026-10-25/supabase/. Re-ignored AFTER the negations
# above so these paths stay out of the public repo (audit 2026-10-25).
workspace/supabase/ainventory-import/sheets/
workspace/supabase/ainventory-import/source/
workspace/supabase/ainventory-import/SOURCE_SUMMARY.json
workspace/supabase/muse-dev/backup/config.json
go/

# === Platform docs (Meta maintains them, but we track them to see changes) ===
# (docs/ is tracked)

# === Generated data (regenerable, too big for git) ===
notes/disk-listings/
.codedb/
bin/
git/

# === Dispatcher runtime state (stubs, cache, locks — regenerated on use) ===
tools/bin/
tools/dispatcher/cache/
.nix-repair.lock
.gitconfig
.gitconfig.bak*

# mcp-remote OAuth token cache (secrets, machine-local)
.mcp-auth/
/notes/TODO.md

# === Secrets & tool-state dotdirs (2026-10-25) ===
# Secret values on disk — never track; restored from Bitwarden by tooling.
/tools/secrets.d/

# Credential-handling scripts are TRACKED (Drew 2026-10-25: they handle
# secrets but hold no values — audited; values live in Bitwarden only).

# Tool-state dotdirs/files: live tokens, session state, logs, caches.
# Ignored wholesale; audited pure-config files unignored individually below.
.claude.json
.zcompdump
.dbus/
.supabase/
.commandcode/
.opencode-mem/
.turso/
.wrangler/

# --- .claude/: all ignored except audited clean config (settings + hooks) ---
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/codedb-block-legacy.sh
!.claude/hooks/codedb-warmup.sh

# --- .codex/: all ignored except audited clean config ---
.codex/*
!.codex/config.toml

# --- .gemini/: all ignored except audited clean config ---
.gemini/*
!.gemini/settings.json
